<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Halaman 1 dari 3: Perekam suara" />

        <TextView
            android:id="@+id/status"
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suara: tidak merekam." />

        <Button
            android:id="@+id/mainAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_voice" />

        <Button
            android:id="@+id/stopAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stop"
            android:visibility="gone" />

        <Button
            android:id="@+id/listAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_voice_list" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pintasan cepat" />

        <Button
            android:id="@+id/addVoiceTile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_voice_tile" />

        <Button
            android:id="@+id/addScreenTile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_screen_tile" />

        <Button
            android:id="@+id/addPauseTile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_pause_tile" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/battery_title" />

        <TextView
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/battery_help" />

        <Button
            android:id="@+id/battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/battery_button" />

        <Button
            android:id="@+id/appInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_info" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_title" />

        <TextView
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_body" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quick_help_title" />

        <TextView
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quick_help_body" />
    </LinearLayout>
</ScrollView>